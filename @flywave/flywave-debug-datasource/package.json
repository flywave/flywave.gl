{
    "name": "@flywave/flywave-debug-datasource",
    "version": "0.28.0",
    "description": "Overlay useful for debugging map data",
    "main": "./lib/src/index.js",
    "typings": "./lib/src/index",
    "exports": {
        ".": {
            "import": "./lib/src/index.js",
            "require": "./lib/src/index.js"
        },
        "./*": {
            "import": "./lib/src/*",
            "require": "./lib/src/*"
        }
    },
    "directories": {
        "lib": "lib"
    },
    "scripts": {
        "build": "tsc --build --verbose $EXTRA_TSC_ARGS ",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-debug-datasource"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-lrucache": "workspace:*",
        "@flywave/flywave-mapview": "workspace:*",
        "@flywave/flywave-text-canvas": "workspace:*"
    },
    "devDependencies": {
        "@types/chai": "catalog:",
        "@types/mocha": "catalog:",
        "@types/node": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "source-map-support": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "three": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
