{
    "name": "@flywave/flywave-map-theme",
    "version": "0.28.0",
    "description": "Map themes",
    "main": "index.js",
    "typings": "index",
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "prepare-icons": "ts-node ./scripts/prepareIcons.ts",
        "prepare": "cross-env tsc --sourceMap false $EXTRA_TSC_ARGS && ts-node scripts/prepack.ts"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-map-theme"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@flywave/flywave-atlas-tools": "workspace:*",
        "@flywave/flywave-datasource-protocol": "workspace:*",
        "@here/harp-fontcatalog": "catalog:",
        "@flywave/flywave-test-utils": "workspace:*",
        "@types/ajv": "catalog:",
        "@types/chai": "catalog:",
        "@types/mocha": "catalog:",
        "@types/ncp": "catalog:",
        "ajv": "catalog:",
        "chai": "catalog:",
        "copyfiles": "catalog:",
        "cross-env": "catalog:",
        "github-download": "catalog:",
        "mkpath": "catalog:",
        "mocha": "catalog:",
        "ncp": "catalog:",
        "source-map-support": "catalog:",
        "tmp": "catalog:",
        "ts-node": "catalog:",
        "typescript": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
