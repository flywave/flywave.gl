{
    "name": "@flywave/flywave-heightmap-painter",
    "version": "1.0.0",
    "description": "Interactive heightmap painting tool with 2D map and 3D preview",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js",
            "require": "./lib/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "prepublishOnly": "pnpm run build"
    },
    "keywords": [
        "heightmap",
        "terrain",
        "painting",
        "3d",
        "webgl",
        "gis",
        "react",
        "typescript",
        "flywave"
    ],
    "author": "flywave.gl contributors",
    "license": "Apache-2.0",
    "peerDependencies": {
        "react": "catalog:",
        "react-dom": "catalog:",
        "styled-components": "^6.1.6",
        "leaflet": "~1.9.4",
        "@jonatanheyman/leaflet-areaselect": "^1.2.0"
    },
    "devDependencies": {
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/styled-components": "^5.1.34",
        "typescript": "^5.6.0"
    }
}
