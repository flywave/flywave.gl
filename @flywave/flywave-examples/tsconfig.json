{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./lib",
        "composite": true,
        "paths": {
            "@flywave/flywave-datasource-protocol": ["../flywave-datasource-protocol/src"],
            "@flywave/flywave-datasource-protocol/*": ["../flywave-datasource-protocol/src/*"],
            "@flywave/flywave-vectortile-datasource": ["../flywave-vectortile-datasource/src"],
            "@flywave/flywave-vectortile-datasource/*": ["../flywave-vectortile-datasource/src/*"],
            "@flywave/flywave-fetch": ["../flywave-fetch/src"],
            "@flywave/flywave-geometry": ["../flywave-geometry/src"],
            "@flywave/flywave-geometry/*": ["../flywave-geometry/src/*"],
            "@flywave/flywave-geoutils": ["../flywave-geoutils/src"],
            "@flywave/flywave-geoutils/*": ["../flywave-geoutils/src/*"],
            "@flywave/flywave-lines": ["../flywave-lines/src"],
            "@flywave/flywave-lines/*": ["../flywave-lines/src/*"],
            "@flywave/flywave-lrucache": ["../flywave-lrucache/src"],
            "@flywave/flywave-materials": ["../flywave-materials/src"],
            "@flywave/flywave-materials/*": ["../flywave-materials/src/*"],
            "@flywave/flywave-text-canvas": ["../flywave-text-canvas/src"],
            "@flywave/flywave-text-canvas/*": ["../flywave-text-canvas/src/*"],
            "@flywave/flywave-transfer-manager": ["../flywave-transfer-manager/src"],
            "@flywave/flywave-utils": ["../flywave-utils/src"],
            "@flywave/flywave-mapview": ["../flywave-mapview/src"],
            "@flywave/flywave-mapview/*": ["../flywave-mapview/src/*"],
            "@flywave/flywave-mapview-decoder": ["../flywave-mapview-decoder/src"],
            "@flywave/flywave-mapview-decoder/*": ["../flywave-mapview-decoder/src/*"],
            "@flywave/flywave-webtile-datasource": ["../flywave-webtile-datasource/src"],
            "@flywave/flywave-webtile-datasource/*": ["../flywave-webtile-datasource/src/*"],
            "@flywave/flywave-test-utils": ["../flywave-test-utils/src/index.web.ts"],
            "@flywave/flywave-test-utils/*": ["../flywave-test-utils/src/*"],
            "@flywave/flywave-map-controls": ["../flywave-map-controls/src"],
            "@flywave/flywave-map-controls/*": ["../flywave-map-controls/src/*"],
            "@flywave/flywave-3dtile-render": ["../flywave-3dtile-render/src"]
        }
    },
    "include": [
        "example-browser.ts",
        "codebrowser.ts",
        "src/**/*.ts",
        "decoder/**/*",
        "resources/**/*",
        "resources/**/*.json"
    ],
    "exclude": ["**/node_modules/**"],
    "references": [
        {
            "path": "../flywave-datasource-protocol"
        },
        {
            "path": "../flywave-fetch"
        },
        {
            "path": "../flywave-geometry"
        },
        {
            "path": "../flywave-geoutils"
        },
        {
            "path": "../flywave-lines"
        },
        {
            "path": "../flywave-lrucache"
        },
        {
            "path": "../flywave-materials"
        },
        {
            "path": "../flywave-text-canvas"
        },
        {
            "path": "../flywave-transfer-manager"
        },
        {
            "path": "../flywave-utils"
        },
        {
            "path": "../flywave-mapview"
        },
        {
            "path": "../flywave-mapview-decoder"
        },
        {
            "path": "../flywave-vectortile-datasource"
        },
        {
            "path": "../flywave-webtile-datasource"
        },
        {
            "path": "../flywave-test-utils"
        },
        {
            "path": "../flywave-map-controls"
        },
        {
            "path": "../flywave-3dtile-render"
        }
    ]
}
