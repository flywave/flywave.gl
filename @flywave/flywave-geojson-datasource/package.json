{
    "name": "@flywave/flywave-geojson-datasource",
    "version": "0.28.0",
    "description": "Provides support for GeoJSON datasource",
    "main": "./lib/index.js",
    "typings": "./lib/index",
    "worker": {
        "name": "@flywave/flywave-geojson-datasource-worker",
        "main": "index-worker.js"
    },
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "require": "./lib/index.js"
        },
        "./*": {
            "import": "./lib/*",
            "require": "./lib/*"
        }
    },
    "scripts": {
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-geojson-datasource"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-utils": "workspace:*",
        "@flywave/flywave-vectortile-datasource": "workspace:*"
    },
    "devDependencies": {
        "@flywave/flywave-test-utils": "workspace:*",
        "@types/chai": "catalog:",
        "@types/mocha": "catalog:",
        "@types/node": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "sinon": "catalog:",
        "source-map-support": "catalog:",
        "three": "catalog:",
        "typescript": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
