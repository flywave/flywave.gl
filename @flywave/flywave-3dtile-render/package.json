{
    "name": "@flywave/flywave-3dtile-render",
    "version": "0.28.0",
    "description": "This module adds a subset of the fetch API for Node.js",
    "main": "lib/index.js",
    "browser": "lib/index.js",
    "typings": "lib/index.web",
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-fetch"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://flywave.net"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-mapview": "workspace:*",
        "path-browserify": "^1.0.1"
    },
    "devDependencies": {
        "@types/path-browserify": "^1.0.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
