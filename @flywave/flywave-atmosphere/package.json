{
    "name": "@flywave/flywave-atmosphere",
    "version": "0.0.1",
    "description": "Bruneton 2017 precomputed atmospheric scattering for flywave.gl",
    "main": "lib/src/index.js",
    "typings": "lib/src/index",
    "exports": {
        ".": {
            "import": "./lib/src/index.js",
            "require": "./lib/src/index.js"
        },
        "./*": {
            "import": "./lib/src/*",
            "require": "./lib/src/*"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "cross-env tsc --build $EXTRA_TSC_ARGS",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS --force"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/flywave/flywave.gl.git",
        "directory": "@flywave/flywave-atmosphere"
    },
    "author": {
        "name": "flywave.gl contributors",
        "url": "https://flywave.net"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-geoutils": "workspace:*",
        "@petamoriken/float16": "^3.0.0",
        "tiny-invariant": "^1.3.3",
        "url-join": "^5.0.0",
        "astronomy-engine": "^2.1.19"
    },
    "devDependencies": {
        "@types/chai": "catalog:",
        "@types/mocha": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "source-map-support": "catalog:",
        "three": "catalog:",
        "typescript": "catalog:",
        "postprocessing": "catalog:"
    },
    "peerDependencies": {
        "three": "catalog:",
        "postprocessing": "catalog:"
    },
    "private": true
}
