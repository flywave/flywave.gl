{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./lib",
        "composite": true,
        "paths": {
            "@flywave/flywave-datasource-protocol": ["../flywave-datasource-protocol/src"],
            "@flywave/flywave-datasource-protocol/*": ["../flywave-datasource-protocol/src/*"],
            "@flywave/flywave-geoutils": ["../flywave-geoutils/src"],
            "@flywave/flywave-geoutils/*": ["../flywave-geoutils/src/*"],
            "@flywave/flywave-mapview": ["../flywave-mapview/src"],
            "@flywave/flywave-mapview/*": ["../flywave-mapview/src/*"],
            "@flywave/flywave-mapview-decoder": ["../flywave-mapview-decoder/src"],
            "@flywave/flywave-mapview-decoder/*": ["../flywave-mapview-decoder/src/*"],
            "@flywave/flywave-vectortile-datasource": ["../flywave-vectortile-datasource/src"],
            "@flywave/flywave-vectortile-datasource/*": ["../flywave-vectortile-datasource/src/*"],
            "@flywave/flywave-utils": ["../flywave-utils/src"],
            "@flywave/flywave-fetch": ["../flywave-fetch/src"],
            "@flywave/flywave-test-utils": ["../flywave-test-utils/src"],
            "@flywave/flywave-materials": ["../flywave-materials/src"],
            "@flywave/flywave-materials/*": ["../flywave-materials/src/*"],
            "@flywave/flywave-lines": ["../flywave-lines/src"],
            "@flywave/flywave-lines/*": ["../flywave-lines/src/*"],
            "@flywave/flywave-text-canvas": ["../flywave-text-canvas/src"],
            "@flywave/flywave-text-canvas/*": ["../flywave-text-canvas/src/*"]
        }
    },
    "include": ["src/**/*", "test/**/*"],
    "exclude": ["dist/**", "node_modules"],
    "references": [
        { "path": "../flywave-datasource-protocol" },
        { "path": "../flywave-geoutils" },
        { "path": "../flywave-mapview" },
        { "path": "../flywave-mapview-decoder" },
        { "path": "../flywave-vectortile-datasource" },
        { "path": "../flywave-utils" },
        { "path": "../flywave-fetch" },
        { "path": "../flywave-test-utils" },
        { "path": "../flywave-materials" },
        { "path": "../flywave-lines" },
        { "path": "../flywave-text-canvas" }
    ]
}
