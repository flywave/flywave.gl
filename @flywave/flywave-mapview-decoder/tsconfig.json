{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./lib",
        "rootDir": "./src",
        "sourceMap": true,
        "composite": true,
        "incremental": true,
        "declarationMap": true,
        "paths": {
            "@flywave/flywave-datasource-protocol": ["../flywave-datasource-protocol/lib"],
            "@flywave/flywave-fetch": ["../flywave-fetch/lib"],
            "@flywave/flywave-utils": ["../flywave-utils/lib"],
            "@flywave/flywave-lrucache": ["../flywave-lrucache/lib"],
            "@flywave/flywave-geoutils": ["../flywave-geoutils/lib"],
            "@flywave/flywave-mapview": ["../flywave-mapview/lib"], 
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": ["dist/**", "test/**", "node_modules"],
    "references": [
        {
            "path": "../flywave-datasource-protocol"
        },
        {
            "path": "../flywave-fetch"
        },
        {
            "path": "../flywave-geoutils"
        },
        {
            "path": "../flywave-lrucache"
        },
        {
            "path": "../flywave-mapview"
        },
        {
            "path": "../flywave-utils"
        }
    ]
}
