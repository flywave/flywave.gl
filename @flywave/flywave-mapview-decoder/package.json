{
    "name": "@flywave/flywave-mapview-decoder",
    "version": "0.28.0",
    "description": "Decoder worker for mapview",
    "main": "index.js",
    "typings": "index",
    "worker": {
        "name": "@flywave/flywave-mapview-decoder-worker",
        "main": "index-worker.js"
    },
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-datasource-protocol": "workspace:*",
        "@flywave/flywave-fetch": "workspace:*",
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-lrucache": "workspace:*",
        "@flywave/flywave-mapview": "workspace:*",
        "@flywave/flywave-utils": "workspace:*",
        "geojson-vt": "catalog:"
    },
    "devDependencies": {
        "@flywave/flywave-test-utils": "workspace:*",
        "@types/chai": "catalog:",
        "@types/chai-as-promised": "catalog:",
        "@types/mocha": "catalog:",
        "@types/sinon": "catalog:",
        "chai": "catalog:",
        "chai-as-promised": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "sinon": "catalog:",
        "source-map-support": "catalog:",
        "typescript": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
