{
    "name": "@flywave/flywave-lrucache",
    "version": "0.28.0",
    "description": "LRU cache",
    "main": "lib/index.js",
    "typings": "lib/index",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "require": "./lib/index.js"
        },
        "./*": {
            "import": "./lib/*",
            "require": "./lib/*"
        }
    },
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-lrucache"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-utils": "workspace:*"
    },
    "devDependencies": {
        "@types/chai": "catalog:",
        "@types/mocha": "catalog:",
        "@types/node": "catalog:",
        "chai": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "source-map-support": "catalog:",
        "typescript": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
