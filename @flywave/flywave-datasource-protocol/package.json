{
    "name": "@flywave/flywave-datasource-protocol",
    "version": "0.28.0",
    "description": "Components used for the decoding and styling of data that is used by the Datasources.",
    "main": "./lib/index.js",
    "typings": "./lib/index",
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS",
        "generate-json-schema": "typeconv -f ts -t jsc ./src/Theme.ts && cp ./src/Theme.json theme.schema.json && rm ./src/Theme.json "
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-datasource-protocol"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-geometry": "workspace:*",
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-utils": "workspace:*",
        "csscolorparser": "catalog:"
    },
    "devDependencies": {
        "@flywave/flywave-test-utils": "workspace:*",
        "@types/chai": "catalog:",
        "@types/mocha": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "source-map-support": "catalog:",
        "three": "catalog:",
        "typeconv": "catalog:",
        "typescript": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
