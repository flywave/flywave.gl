{
    "name": "@flywave/flywave-map-controls",
    "version": "0.28.0",
    "description": "Camera controller which implements a common default set of camera functionality in a map context.",
    "main": "index.js",
    "typings": "index",
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-map-controls"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-mapview": "workspace:*",
        "@flywave/flywave-utils": "workspace:*",
        "@tweenjs/tween.js": "catalog:"
    },
    "devDependencies": {
        "@types/chai": "catalog:",
        "@types/mocha": "catalog:",
        "@types/node": "catalog:",
        "@types/sinon": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "sinon": "catalog:",
        "source-map-support": "catalog:",
        "three": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "three": "^0.151.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
