{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "sourceMap": true,
        "composite": true,
        "incremental": true,
        "declarationMap": true,
        "paths": {
            "@flywave/flywave-datasource-protocol": ["../flywave-datasource-protocol/lib"],
            "@flywave/flywave-geometry": ["../flywave-geometry/lib"],
            "@flywave/flywave-geoutils": ["../flywave-geoutils/lib"],
            "@flywave/flywave-lines": ["../flywave-lines/lib"],
            "@flywave/flywave-lrucache": ["../flywave-lrucache/lib"],
            "@flywave/flywave-mapview": ["../flywave-mapview/lib"],
            "@flywave/flywave-materials": ["../flywave-materials/lib"],
            "@flywave/flywave-text-canvas": ["../flywave-text-canvas/lib"],
            "@flywave/flywave-transfer-manager": ["../flywave-transfer-manager/lib"],
            "@flywave/flywave-utils": ["../flywave-utils/lib"],
            "@flywave/flywave-mapview-decoder": ["../flywave-mapview-decoder/lib"],
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": ["dist/**", "test/**", "node_modules"],
    "references": [
        {
            "path": "../flywave-datasource-protocol"
        },
        {
            "path": "../flywave-geometry"
        },
        {
            "path": "../flywave-geoutils"
        },
        {
            "path": "../flywave-lines"
        },
        {
            "path": "../flywave-lrucache"
        },
        {
            "path": "../flywave-mapview"
        },
        {
            "path": "../flywave-mapview-decoder"
        },
        {
            "path": "../flywave-materials"
        },
        {
            "path": "../flywave-text-canvas"
        },
        {
            "path": "../flywave-transfer-manager"
        },
        {
            "path": "../flywave-utils"
        }
    ]
}
