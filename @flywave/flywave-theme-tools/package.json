{
    "name": "@flywave/flywave-theme-tools",
    "version": "0.28.0",
    "description": "Tools for flywave.gl-theme optimiziation.",
    "bin": {
        "flywave-theme-optimizer": "lib/cli-build-theme.js"
    },
    "scripts": {
        "build": "tsc --build",
        "watch": "tsc --build -w",
        "buildTheme": "ts-node src/cli-build-theme.ts",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-theme-tools"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "keywords": [
        "here",
        "flywave.gl",
        "theme"
    ],
    "dependencies": {
        "@flywave/flywave-mapview": "workspace:*",
        "commander": "catalog:",
        "glob": "catalog:",
        "path": "catalog:"
    },
    "devDependencies": {
        "ts-node": "catalog:",
        "typescript": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
