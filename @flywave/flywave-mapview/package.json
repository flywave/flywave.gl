{
    "name": "@flywave/flywave-mapview",
    "version": "0.28.0",
    "description": "Functionality needed to render a map.",
    "keywords": [
        "map",
        "map-renderer",
        "vector-tiles",
        "geojson",
        "typescript",
        "webgl",
        "harpgl"
    ],
    "main": "lib/src/index.js",
    "typings": "lib/src/index",
    "exports": {
        ".": {
            "import": "./lib/src/index.js",
            "require": "./lib/src/index.js"
        },
        "./*": {
            "import": "./lib/src/*",
            "require": "./lib/src/*"
        }
    },
    "directories": {
        "test": "test"
    },
    "scripts": {
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-mapview"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-datasource-protocol": "workspace:*",
        "@flywave/flywave-fetch": "workspace:*",
        "@flywave/flywave-geometry": "workspace:*",
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-lines": "workspace:*",
        "@flywave/flywave-lrucache": "workspace:*",
        "@flywave/flywave-materials": "workspace:*",
        "@flywave/flywave-text-canvas": "workspace:*",
        "@flywave/flywave-transfer-manager": "workspace:*",
        "@flywave/flywave-utils": "workspace:*",
        "rbush": "catalog:",
        "postprocessing": "catalog:"
    },
    "devDependencies": {
        "@flywave/flywave-test-utils": "workspace:*",
        "@types/chai": "catalog:",
        "@types/chai-as-promised": "catalog:",
        "@types/mocha": "catalog:",
        "@types/node": "catalog:",
        "@types/sinon": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "chai-as-promised": "catalog:",
        "copyfiles": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "sinon": "catalog:",
        "source-map-support": "catalog:",
        "three": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "three": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
