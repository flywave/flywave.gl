{
    "name": "@flywave/flywave-topo",
    "version": "0.28.0",
    "description": "HERE Terrain Data source",
    "main": "lib/src/index.js",
    "typings": "lib/src/index",
    "exports": {
        ".": {
            "import": "./lib/src/index.js",
            "require": "./lib/src/index.js"
        },
        "./*": {
            "import": [
                "./lib/src/*.js",
                "./lib/src/*/index.js"
            ],
            "require": [
                "./lib/src/*.js",
                "./lib/src/*/index.js"
            ]
        }
    },
    "directories": {
        "test": "test"
    },
    "scripts": {
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/*.js",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-topo"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-mapview": "workspace:*",
        "@flywave/flywave-mapview-decoder": "workspace:*",
        "@flywave/flywave-draco": "workspace:*",
        "flatbuffers": "~1.12.0",
        "js-base64": "^3.7.5"
    },
    "devDependencies": {
        "@flywave/flywave-datasource-protocol": "workspace:*",
        "@flywave/flywave-fetch": "workspace:*",
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-test-utils": "workspace:*",
        "@types/flatbuffers": "~1.10.0",
        "@types/chai": "catalog:",
        "@types/earcut": "catalog:",
        "@types/long": "catalog:",
        "@types/mocha": "catalog:",
        "@types/node": "catalog:",
        "@types/sinon": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "copyfiles": "catalog:",
        "cross-env": "catalog:",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "mocha": "catalog:",
        "sinon": "catalog:",
        "source-map-support": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "three": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
