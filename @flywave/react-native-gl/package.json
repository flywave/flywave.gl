{
    "name": "@flywave/react-native-gl",
    "version": "0.0.1",
    "description": "React Native adapter for flywave.gl - enables @flywave/flywave.gl to run on React Native",
    "main": "lib/src/index.js",
    "types": "lib/src/index.d.ts",
    "scripts": {
        "build": "cross-env tsc --build $EXTRA_TSC_ARGS --force",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS --force"
    },
    "devDependencies": {
        "@flywave/flywave.gl": "workspace:*",
        "expo": "catalog:",
        "expo-three": "catalog:",
        "expo-gl": "catalog:",
        "three": "catalog:",
        "@types/three": "catalog:",
        "react-native": "catalog:",
        "@types/react": "catalog:",
        "@types/react-native": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*"
    },
    "publishConfig": {
        "access": "public"
    },
    "private": true
}