{
    "name": "@flywave/flywave.gl",
    "version": "0.0.1",
    "description": "WebGl GIS",
    "main": "src/index.js",
    "scripts": {
        "build-dev": "webpack",
        "build:svg:sprite": "svg-sprite --symbol --symbol-dest . --shape-id-generator \"iD-%s\" --symbol-sprite src/menu/sprite.svg \"src/image/icon/**/*.svg\"",
