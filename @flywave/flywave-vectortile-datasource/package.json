{
    "name": "@flywave/flywave-vectortile-datasource",
    "version": "0.28.0",
    "description": "HERE Vector Tile Data Source",
    "main": "lib/index.js",
    "typings": "lib/index",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "require": "./lib/index.js"
        },
        "./*": {
            "import": "./lib/*",
            "require": "./lib/*"
        }
    },
    "worker": {
        "name": "@flywave/flywave-vectortile-datasource-worker",
        "main": "lib/index-worker.js"
    },
    "directories": {
        "test": "test"
    },
    "scripts": {
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/OmvTest.js",
        "gen-decoder": "pbjs -t static-module -w commonjs --no-encode --no-verify --no-create src/adapters/omv/proto/vector_tile.proto -o src/adapters/omv/proto/vector_tile.js && pbts src/adapters/omv/proto/vector_tile.js -o src/adapters/omv/proto/vector_tile.d.ts",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-vectortile-datasource"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-datasource-protocol": "workspace:*",
        "@flywave/flywave-geometry": "workspace:*",
        "@flywave/flywave-geoutils": "workspace:*",
        "@flywave/flywave-lines": "workspace:*",
        "@flywave/flywave-lrucache": "workspace:*",
        "@flywave/flywave-mapview": "workspace:*",
        "@flywave/flywave-mapview-decoder": "workspace:*",
        "@flywave/flywave-materials": "workspace:*",
        "@flywave/flywave-text-canvas": "workspace:*",
        "@flywave/flywave-transfer-manager": "workspace:*",
        "@flywave/flywave-utils": "workspace:*",
        "earcut": "catalog:",
        "long": "catalog:",
        "protobufjs": "catalog:"
    },
    "devDependencies": {
        "@flywave/flywave-fetch": "workspace:*",
        "@flywave/flywave-test-utils": "workspace:*",
        "@types/chai": "catalog:",
        "@types/earcut": "catalog:",
        "@types/long": "catalog:",
        "@types/mocha": "catalog:",
        "@types/node": "catalog:",
        "@types/sinon": "catalog:",
        "@types/three": "catalog:",
        "chai": "catalog:",
        "copyfiles": "catalog:",
        "cross-env": "catalog:",
        "mocha": "catalog:",
        "sinon": "catalog:",
        "source-map-support": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "three": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    }
}
