{
    "name": "@flywave/flywave-vectortile-datasource",
    "version": "0.28.0",
    "description": "HERE Vector Tile Data Source",
    "main": "index.js",
    "typings": "index",
    "worker": {
        "name": "@flywave/flywave-vectortile-datasource-worker",
        "main": "index-worker.js"
    },
    "directories": {
        "test": "test"
    },
    "scripts": {
        "build": "tsc --build $EXTRA_TSC_ARGS",
        "test": "cross-env mocha --require source-map-support/register $EXTRA_MOCHA_ARGS ./test/OmvTest.js",
        "gen-decoder": "pbjs -t static-module -w commonjs --no-encode --no-verify --no-create lib/adapters/omv/proto/vector_tile.proto -o lib/adapters/omv/proto/vector_tile.js && pbts lib/adapters/omv/proto/vector_tile.js -o lib/adapters/omv/proto/vector_tile.d.ts",
        "prepare": "cross-env tsc --build $EXTRA_TSC_ARGS"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/heremaps/flywave.gl.git",
        "directory": "@flywave/flywave-vectortile-datasource"
    },
    "author": {
        "name": "HERE Europe B.V.",
        "url": "https://here.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@flywave/flywave-datasource-protocol": "^0.28.0",
        "@flywave/flywave-geometry": "^0.28.0",
        "@flywave/flywave-geoutils": "^0.28.0",
        "@flywave/flywave-lines": "^0.28.0",
        "@flywave/flywave-lrucache": "^0.28.0",
        "@flywave/flywave-mapview": "^0.28.0",
        "@flywave/flywave-mapview-decoder": "^0.28.0",
        "@flywave/flywave-materials": "^0.28.0",
        "@flywave/flywave-text-canvas": "^0.28.0",
        "@flywave/flywave-transfer-manager": "^0.28.0",
        "@flywave/flywave-utils": "^0.28.0",
        "earcut": "^2.2.2",
        "long": "^4.0.0",
        "protobufjs": "^6.9.0"
    },
    "devDependencies": {
        "@flywave/flywave-fetch": "^0.28.0",
        "@flywave/flywave-test-utils": "^0.28.0",
        "@types/chai": "^4.2.14",
        "@types/earcut": "^2.1.1",
        "@types/long": "^4.0.1",
        "@types/mocha": "^8.2.0",
        "@types/node": "^14.0.5",
        "@types/sinon": "^9.0.10",
        "@types/three": "^0.129.0",
        "chai": "^4.0.2",
        "copyfiles": "^2.2.0",
        "cross-env": "^7.0.2",
        "mocha": "^8.2.1",
        "sinon": "^9.2.2",
        "source-map-support": "^0.5.19",
        "typescript": "^4.1.2"
    },
    "peerDependencies": {
        "three": "^0.129.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
